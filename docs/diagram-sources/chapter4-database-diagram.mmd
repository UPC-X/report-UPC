erDiagram
  students {
    uuid id
    varchar_254_ email
    varchar_80_ name
    text password_hash
    boolean verified
    varchar_100_ career
    smallint academic_cycle
    varchar_5_ preferred_language
    varchar_9_ payment_phone
    uuid avatar_image_id
    timestamptz created_at
  }
  challenges {
    uuid id
    uuid student_id
    varchar_10_ purpose
    text secret_hash
    timestamptz expires_at
    integer attempts
    boolean used
    timestamptz created_at
  }
  sessions {
    text token_hash
    uuid student_id
    timestamptz expires_at
  }
  images {
    uuid id
    uuid owner_id
    text object_key
    varchar_30_ content_type
    bigint byte_size
    varchar_10_ purpose
    varchar_7_ visibility
    timestamptz created_at
  }
  campuses {
    uuid id
    varchar_30_ name
    boolean active
  }
  categories {
    uuid id
    varchar_30_ code
    varchar_60_ name_es
    varchar_60_ name_en
    boolean active
  }
  listings {
    uuid id
    uuid seller_id
    uuid category_id
    uuid campus_id
    varchar_100_ title
    varchar_2000_ description
    numeric_10_2_ price
    varchar_10_ type
    varchar_10_ condition
    boolean continuous
    varchar_12_ status
    boolean under_review
    uuid reserved_deal_id
    timestamptz created_at
  }
  listing_images {
    uuid listing_id
    uuid image_id
    smallint position
    boolean is_cover
  }
  favorites {
    uuid student_id
    uuid listing_id
    timestamptz created_at
  }
  conversations {
    uuid id
    uuid listing_id
    uuid buyer_id
    timestamptz created_at
  }
  messages {
    uuid id
    uuid conversation_id
    uuid sender_id
    varchar_8_ kind
    varchar_2000_ content
    uuid image_id
    timestamptz created_at
  }
  deals {
    uuid id
    uuid conversation_id
    uuid campus_id
    numeric_10_2_ price
    varchar_200_ meeting_point
    timestamptz meeting_at
    boolean buyer_accepted
    boolean seller_accepted
    boolean buyer_confirmed
    boolean seller_confirmed
    varchar_12_ status
    timestamptz created_at
  }
  reviews {
    uuid id
    uuid deal_id
    uuid reviewer_id
    smallint rating
    varchar_1000_ comment
    timestamptz created_at
  }
  payment_evidences {
    uuid id
    uuid deal_id
    uuid conversation_id
    uuid message_id
    uuid image_id
    uuid uploaded_by
    varchar_5_ method
    numeric_10_2_ amount
    varchar_8_ status
    timestamptz created_at
  }
  deal_events {
    uuid id
    uuid deal_id
    uuid actor_id
    varchar_20_ event_type
    timestamptz created_at
  }
  reports {
    uuid id
    uuid reporter_id
    uuid listing_id
    uuid deal_id
    varchar_30_ reason
    varchar_2000_ detail
    varchar_10_ status
    timestamptz created_at
  }
  notifications {
    uuid id
    uuid recipient_id
    uuid deal_id
    uuid message_id
    varchar_30_ kind
    timestamptz read_at
    timestamptz created_at
  }
  support_tickets {
    uuid id
    uuid student_id
    varchar_100_ subject
    varchar_2000_ body
    varchar_10_ status
    timestamptz created_at
  }
  students ||--o{ challenges : "student_id"
  students ||--o{ sessions : "student_id"
  students ||--o{ images : "owner_id"
  students ||--o{ listings : "seller_id"
  categories ||--o{ listings : "category_id"
  campuses ||--o{ listings : "campus_id"
  listings ||--o{ listing_images : "listing_id"
  images ||--o{ listing_images : "image_id"
  students ||--o{ favorites : "student_id"
  listings ||--o{ favorites : "listing_id"
  listings ||--o{ conversations : "listing_id"
  students ||--o{ conversations : "buyer_id"
  conversations ||--o{ messages : "conversation_id"
  students ||--o{ messages : "sender_id"
  images |o--o{ messages : "image_id"
  conversations ||--o| deals : "conversation_id"
  campuses ||--o{ deals : "campus_id"
  deals ||--o{ reviews : "deal_id"
  students ||--o{ reviews : "reviewer_id"
  images ||--o{ payment_evidences : "image_id"
  students ||--o{ payment_evidences : "uploaded_by"
  deals ||--o{ deal_events : "deal_id"
  students ||--o{ deal_events : "actor_id"
  students ||--o{ reports : "reporter_id"
  listings |o--o{ reports : "listing_id"
  deals |o--o{ reports : "deal_id"
  students ||--o{ notifications : "recipient_id"
  deals |o--o{ notifications : "deal_id"
  messages |o--o{ notifications : "message_id"
  students ||--o{ support_tickets : "student_id"
  images |o--o{ students : "avatar_image_id"
  deals |o--o| listings : "reserved_deal_id"
  deals ||--o{ payment_evidences : "deal_id + conversation_id"
  messages ||--o| payment_evidences : "message_id + conversation_id"
