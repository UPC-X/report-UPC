@startuml
title UPC-X - Modelo OBJETIVO (no migracion vigente)
hide circle
skinparam linetype ortho
entity students #EAF2FB {
  id : uuid
  email : varchar(254)
  name : varchar(80)
  password_hash : text
  verified : boolean
  career : varchar(100)
  academic_cycle : smallint
  preferred_language : varchar(5)
  payment_phone : varchar(9)
  avatar_image_id : uuid
  created_at : timestamptz
}
entity challenges #EAF2FB {
  id : uuid
  student_id : uuid
  purpose : varchar(10)
  secret_hash : text
  expires_at : timestamptz
  attempts : integer
  used : boolean
  created_at : timestamptz
}
entity sessions #EAF2FB {
  token_hash : text
  student_id : uuid
  expires_at : timestamptz
}
entity images #EAF2FB {
  id : uuid
  owner_id : uuid
  object_key : text
  content_type : varchar(30)
  byte_size : bigint
  purpose : varchar(10)
  visibility : varchar(7)
  created_at : timestamptz
}
entity campuses #FFF6E5 {
  id : uuid
  name : varchar(30)
  active : boolean
}
entity categories #FFF6E5 {
  id : uuid
  code : varchar(30)
  name_es : varchar(60)
  name_en : varchar(60)
  active : boolean
}
entity listings #EAF2FB {
  id : uuid
  seller_id : uuid
  category_id : uuid
  campus_id : uuid
  title : varchar(100)
  description : varchar(2000)
  price : numeric(10,2)
  type : varchar(10)
  condition : varchar(10)
  continuous : boolean
  status : varchar(12)
  under_review : boolean
  reserved_deal_id : uuid
  created_at : timestamptz
}
entity listing_images #FFF6E5 {
  listing_id : uuid
  image_id : uuid
  position : smallint
  is_cover : boolean
}
entity favorites #FFF6E5 {
  student_id : uuid
  listing_id : uuid
  created_at : timestamptz
}
entity conversations #EAF2FB {
  id : uuid
  listing_id : uuid
  buyer_id : uuid
  created_at : timestamptz
}
entity messages #EAF2FB {
  id : uuid
  conversation_id : uuid
  sender_id : uuid
  kind : varchar(8)
  content : varchar(2000)
  image_id : uuid
  created_at : timestamptz
}
entity deals #EAF2FB {
  id : uuid
  conversation_id : uuid
  campus_id : uuid
  price : numeric(10,2)
  meeting_point : varchar(200)
  meeting_at : timestamptz
  buyer_accepted : boolean
  seller_accepted : boolean
  buyer_confirmed : boolean
  seller_confirmed : boolean
  status : varchar(12)
  created_at : timestamptz
}
entity reviews #EAF2FB {
  id : uuid
  deal_id : uuid
  reviewer_id : uuid
  rating : smallint
  comment : varchar(1000)
  created_at : timestamptz
}
entity payment_evidences #FFF6E5 {
  id : uuid
  deal_id : uuid
  conversation_id : uuid
  message_id : uuid
  image_id : uuid
  uploaded_by : uuid
  method : varchar(5)
  amount : numeric(10,2)
  status : varchar(8)
  created_at : timestamptz
}
entity deal_events #FFF6E5 {
  id : uuid
  deal_id : uuid
  actor_id : uuid
  event_type : varchar(20)
  created_at : timestamptz
}
entity reports #FFF6E5 {
  id : uuid
  reporter_id : uuid
  listing_id : uuid
  deal_id : uuid
  reason : varchar(30)
  detail : varchar(2000)
  status : varchar(10)
  created_at : timestamptz
}
entity notifications #FFF6E5 {
  id : uuid
  recipient_id : uuid
  deal_id : uuid
  message_id : uuid
  kind : varchar(30)
  read_at : timestamptz
  created_at : timestamptz
}
entity support_tickets #FFF6E5 {
  id : uuid
  student_id : uuid
  subject : varchar(100)
  body : varchar(2000)
  status : varchar(10)
  created_at : timestamptz
}
students ||--o{ challenges : student_id
students ||--o{ sessions : student_id
students ||--o{ images : owner_id
students ||--o{ listings : seller_id
categories ||--o{ listings : category_id
campuses ||--o{ listings : campus_id
listings ||--o{ listing_images : listing_id
images ||--o{ listing_images : image_id
students ||--o{ favorites : student_id
listings ||--o{ favorites : listing_id
listings ||--o{ conversations : listing_id
students ||--o{ conversations : buyer_id
conversations ||--o{ messages : conversation_id
students ||--o{ messages : sender_id
images |o--o{ messages : image_id
conversations ||--o| deals : conversation_id
campuses ||--o{ deals : campus_id
deals ||--o{ reviews : deal_id
students ||--o{ reviews : reviewer_id
images ||--o{ payment_evidences : image_id
students ||--o{ payment_evidences : uploaded_by
deals ||--o{ deal_events : deal_id
students ||--o{ deal_events : actor_id
students ||--o{ reports : reporter_id
listings |o--o{ reports : listing_id
deals |o--o{ reports : deal_id
students ||--o{ notifications : recipient_id
deals |o--o{ notifications : deal_id
messages |o--o{ notifications : message_id
students ||--o{ support_tickets : student_id
images |o--o{ students : avatar_image_id
deals |o--o| listings : reserved_deal_id
deals ||--o{ payment_evidences : deal_id + conversation_id
messages ||--o| payment_evidences : message_id + conversation_id
@enduml
