@startuml chapter4-database-diagram
' UPC-X - Diagrama relacional (seccion 4.10.1).
' Generado desde el esquema de las migraciones Flyway V1-V13 de upcx-api.
hide circle
skinparam linetype ortho
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 13
skinparam classAttributeFontSize 11
skinparam packageStyle rectangle
skinparam nodesep 45
skinparam ranksep 55
skinparam ArrowColor #444444
skinparam dpi 170
skinparam class {
  BackgroundColor #FFFFFF
  BorderColor #333333
  HeaderBackgroundColor #E8EEF7
}

package "Identidad y acceso" {
  entity students {
    * **id** : uuid <<PK>>
    --
    * email : varchar(254)
    * name : varchar(80)
      password_hash : text
    * verified : bool
      campus : varchar(30)
      career : varchar(80)
      cycle : varchar(20)
    * language : varchar(5)
      payment_phone : varchar(20)
  }
  entity challenges {
    * **id** : uuid <<PK>>
    --
    * student_id : uuid <<FK>>
    * purpose : varchar(10)
    * secret_hash : text
    * expires_at : timestamptz
    * attempts : int
    * used : bool
    * created_at : timestamptz
      pending_name : varchar(80)
      pending_password_hash : text
  }
  entity sessions {
    * **token_hash** : text <<PK>>
    --
    * student_id : uuid <<FK>>
    * expires_at : timestamptz
  }
}

package "Marketplace y medios" {
  entity images {
    * **id** : uuid <<PK>>
    --
    * owner_id : uuid <<FK>>
    * content_type : text
    * created_at : timestamptz
    * object_key : text
    * purpose : varchar(20)
  }
  entity listings {
    * **id** : uuid <<PK>>
    --
    * seller_id : uuid <<FK>>
    * title : varchar(100)
    * description : varchar(2000)
    * price : numeric
    * campus : varchar(30)
    * category : varchar(30)
      condition : varchar(20)
    * image_id : uuid <<FK>>
    * status : varchar(12)
    * created_at : timestamptz
      reserved_deal_id : uuid <<FK>>
    * type : varchar(10)
    * continuous : bool
    * under_review : bool
  }
  entity listing_images {
    * **listing_id** : uuid <<PK>> <<FK>>
    * **image_id** : uuid <<PK>> <<FK>>
    --
    * position : int
  }
  entity favorites {
    * **student_id** : uuid <<PK>> <<FK>>
    * **listing_id** : uuid <<PK>> <<FK>>
    --
    * created_at : timestamptz
  }
}

package "Comunicación" {
  entity conversations {
    * **id** : uuid <<PK>>
    --
    * listing_id : uuid <<FK>>
    * buyer_id : uuid <<FK>>
    * created_at : timestamptz
    * last_activity_at : timestamptz
  }
  entity messages {
    * **id** : uuid <<PK>>
    --
    * conversation_id : uuid <<FK>>
    * sender_id : uuid <<FK>>
    * content : varchar(2000)
    * created_at : timestamptz
      client_id : uuid
  }
  entity conversation_reads {
    * **conversation_id** : uuid <<PK>> <<FK>>
    * **student_id** : uuid <<PK>> <<FK>>
    --
    * read_at : timestamptz
  }
  entity notifications {
    * **id** : uuid <<PK>>
    --
    * recipient_id : uuid <<FK>>
    * kind : varchar(40)
    * deal_id : uuid <<FK>>
    * conversation_id : uuid <<FK>>
      actor_id : uuid <<FK>>
      read_at : timestamptz
    * created_at : timestamptz
  }
}

package "Acuerdos y reputación" {
  entity deals {
    * **id** : uuid <<PK>>
    --
    * conversation_id : uuid <<FK>>
    * price : numeric
    * campus : varchar(30)
    * meeting_point : varchar(200)
    * meeting_at : timestamptz
    * buyer_accepted : bool
    * seller_accepted : bool
    * buyer_confirmed : bool
    * seller_confirmed : bool
    * status : varchar(12)
      proposer_id : uuid <<FK>>
    * created_at : timestamptz
    * updated_at : timestamptz
    * revision : int
  }
  entity deal_events {
    * **id** : uuid <<PK>>
    --
    * deal_id : uuid <<FK>>
      actor_id : uuid <<FK>>
    * type : varchar(20)
      reason : varchar(300)
    * created_at : timestamptz
  }
  entity payment_evidences {
    * **id** : uuid <<PK>>
    --
    * conversation_id : uuid <<FK>>
    * deal_id : uuid <<FK>>
    * author_id : uuid <<FK>>
    * image_id : uuid <<FK>>
    * image_purpose : varchar(20) <<FK>>
    * created_at : timestamptz
      method : varchar(5)
      amount : numeric
      reference : varchar(4)
    * status : varchar(8)
      reviewed_by : uuid <<FK>>
      reviewed_at : timestamptz
      note : varchar(300)
      replaces_id : uuid <<FK>>
  }
  entity reviews {
    * **id** : uuid <<PK>>
    --
    * deal_id : uuid <<FK>>
    * reviewer_id : uuid <<FK>>
    * rating : int
      comment : varchar(1000)
    * created_at : timestamptz
  }
}

package "Soporte" {
  entity reports {
    * **id** : uuid <<PK>>
    --
    * reporter_id : uuid <<FK>>
    * listing_id : uuid <<FK>>
      deal_id : uuid <<FK>>
    * reason : varchar(30)
      detail : varchar(1000)
    * status : varchar(10)
    * created_at : timestamptz
  }
  entity support_tickets {
    * **id** : uuid <<PK>>
    --
      student_id : uuid <<FK>>
    * subject : varchar(100)
    * body : varchar(2000)
    * status : varchar(10)
    * created_at : timestamptz
      contact_email : varchar(254)
  }
}

students ||--o{ challenges : "student_id"
