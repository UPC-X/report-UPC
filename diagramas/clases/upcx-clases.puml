@startuml chapter4-class-diagram
' UPC-X - Diagrama de clases (seccion 4.9.1).
' Refleja el paquete domain/model de upcx-api 0.8.0.
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classFontSize 13
skinparam classAttributeFontSize 11
skinparam packageStyle rectangle
skinparam dpi 150
hide empty members
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 60

package "Identity & Access" {
  class Student <<aggregate>> {
    - id : UUID
    - email : String
    - name : String
    - passwordHash : String [0..1]
    - verified : boolean
    - campus : String [0..1]
    - career : String [0..1]
    - cycle : String [0..1]
    - language : String
    - paymentPhone : String [0..1]
    + hasPassword() : boolean
  }
  class Challenge <<entity>> {
    - id : UUID
    - studentId : UUID
    - purpose : ChallengePurpose
    - secretHash : String
    - expiresAt : Instant
    - attempts : int
    - used : boolean
    - pending : PendingSignup [0..1]
    + {static} issue(studentId, purpose, secretHash, pending, now) : Challenge
    + isOpen(now : Instant) : boolean
    + attempt(code : String, matches) : boolean
    + claim() : Claim
  }
  class PendingSignup <<value>> {
    - pendingName : String
    - pendingPasswordHash : String
  }
  class SessionToken <<value>> {
    - value : String
    + {static} generate(random) : SessionToken
    + digest() : String
  }
}

package "Marketplace" {
  class Listing <<aggregate>> {
    - id : UUID
    - sellerId : UUID
    - details : ListingDetails
    - photos : List<UUID>
    - status : ListingStatus
    - reservedDealId : UUID [0..1]
    + {static} publish(sellerId, details, photos) : Listing
    + revise(details, photos) : void
    + changeStatus(target : ListingStatus) : boolean
    + withdraw() : void
    + ensureOpenTo(buyer : UUID) : void
    + reserveFor(dealId : UUID) : boolean
    + releaseReservationOf(dealId : UUID) : boolean
    + sellThrough(dealId : UUID) : boolean
  }
  class ListingDetails <<value>> {
    - title : String
    - description : String
    - price : BigDecimal
    - campus : String
    - category : String
    - condition : String [0..1]
    - type : String
    - continuous : boolean
  }
  class ListingPhotos <<value>> {
    - ids : List<UUID>
    + {static} MAX = 5
  }
}

package "Media" {
  class Image <<aggregate>> {
    - id : UUID
    - ownerId : UUID
    - objectKey : String
    - purpose : ImagePurpose
    + {static} upload(ownerId, purpose) : Image
  }
}

package "Communication" {
  class Conversation <<aggregate>> {
    - id : UUID
    - listingId : UUID
    - buyerId : UUID
    - sellerId : UUID
    + ensureParticipant(student : UUID) : void
    + isBuyer(student : UUID) : boolean
  }
  class Message <<entity>> {
    - id : UUID
    - conversationId : UUID
    - senderId : UUID
    - content : String
    - clientId : UUID [0..1]
    + {static} post(conversationId, senderId, content, clientId) : Message
  }
}

package "Transactions & Reputation" {
  class Deal <<aggregate>> {
    - id : UUID
    - conversationId : UUID
    - proposerId : UUID
    - terms : DealTerms
    - revision : int
    - status : DealStatus
    - buyerAccepted : boolean
    - sellerAccepted : boolean
    - buyerConfirmed : boolean
    - sellerConfirmed : boolean
    + {static} propose(conversationId, proposer, terms) : Deal
    + revise(terms : DealTerms, by : Participant) : void
    + accept(by : Participant, now) : boolean
    + confirmDelivery(by : Participant) : boolean
    + reportNoShow(by : Participant, now, waitingTime) : void
    + cancel(by : Participant, reason : String) : boolean
    + expire(now, graceTime) : boolean
    + takeEvents() : List<DealEvent>
  }
  class DealTerms <<value>> {
    - price : BigDecimal
    - campus : String
    - meetingPoint : String
    - meetingAt : OffsetDateTime
    + requireFitFor(listingCampus, now) : void
  }
  class Participant <<value>> {
    - id : UUID
    - buyer : boolean
  }
  class DealEvent <<event>> {
    - id : UUID
    - dealId : UUID
    - actorId : UUID [0..1]
    - type : DealEventType
    - reason : String [0..1]
  }
  class PaymentEvidence <<aggregate>> {
    - id : UUID
    - conversationId : UUID
    - dealId : UUID
    - authorId : UUID
    - imageId : UUID
    - details : PaymentDetails
    - replacesId : UUID [0..1]
    - status : EvidenceStatus
    - reviewerId : UUID [0..1]
    - note : String [0..1]
    + {static} attach(conversationId, dealId, authorId, imageId, details, replacesId) : PaymentEvidence
    + declareReceived(reviewer : UUID) : void
    + dispute(reviewer : UUID, note : String) : void
    + ensureCorrectableBy(author : UUID, deal : UUID) : void
  }
  class PaymentDetails <<value>> {
    - method : PaymentMethod
    - amount : BigDecimal
    - reference : String
  }
  class Review <<aggregate>> {
    - id : UUID
    - dealId : UUID
    - reviewerId : UUID
    - rating : int
    - comment : String [0..1]
    + {static} write(dealId, reviewerId, rating, comment) : Review
  }
}

package "Support" {
  class Report <<aggregate>> {
    - id : UUID
    - reporterId : UUID
    - listingId : UUID
    - reason : String
    - detail : String [0..1]
    + {static} create(reporter, listing, reason, detail) : Report
  }
  class SupportTicket <<aggregate>> {
    - id : UUID
    - studentId : UUID
    - subject : String
    - body : String
    + {static} create(student, subject, body) : SupportTicket
  }
  class GuestSupportTicket <<aggregate>> {
    - id : UUID
    - email : String
    - subject : String
    - body : String
    + {static} create(email, subject, body) : GuestSupportTicket
  }
}

package "Enumerations" {
  enum ChallengePurpose {
    VERIFY
    RESET
    LOGIN
  }
  enum Campus {
    MONTERRICO
    SAN_MIGUEL
    SAN_ISIDRO
    VILLA
  }
  enum Category {
    TECHNOLOGY
    BOOKS
    CLOTHING
    OTHER
  }
  enum ListingType {
    PRODUCT
    SERVICE
    TUTORING
  }
  enum ListingCondition {
    NEW
    LIKE_NEW
    USED
  }
  enum ListingStatus {
    AVAILABLE
    PAUSED
    RESERVED
    SOLD
    WITHDRAWN
  }
  enum ImagePurpose {
    LISTING
    PAYMENT_EVIDENCE
  }
  enum DealStatus {
    PROPOSED
    AGREED
    COMPLETED
    CANCELLED
    NO_SHOW
  }
  enum DealEventType {
    PROPOSED
    REVISED
    ACCEPTED
    CONFIRMED
    CANCELLED
    NO_SHOW_REPORTED
    EXPIRED
  }
  enum PaymentMethod {
    YAPE
    PLIN
    OTHER
  }
  enum EvidenceStatus {
    SENT
    RECEIVED
    DISPUTED
  }
}

Student "1" --> "0..*" Challenge : recibe
Challenge *-- "0..1" PendingSignup : conserva alta
Student "1" --> "0..*" SessionToken : inicia sesión
Student "1" --> "0..*" Listing : publica
Listing *-- "1" ListingDetails
Listing ..> ListingPhotos : valida fotos
Listing "1" --> "1..5" Image : fotos
Student "1" --> "0..*" Image : sube
Listing "1" --> "0..*" Conversation : origina
Student "1" --> "0..*" Conversation : contacta
Conversation "1" *-- "0..*" Message : contiene
Student "1" --> "0..*" Message : envía
Conversation "1" --> "0..*" Deal : coordina\n{a lo sumo uno activo}
Listing "0..1" --> "0..1" Deal : reserva
Deal *-- "1" DealTerms
Deal *-- "0..*" DealEvent : registra
Deal ..> Participant : actúa
Deal "1" --> "0..*" PaymentEvidence : respalda
PaymentEvidence *-- "1" PaymentDetails
PaymentEvidence "1" --> "1" Image : captura privada
PaymentEvidence "0..1" --> "0..1" PaymentEvidence : corrige
Deal "1" --> "0..2" Review : habilita
Student "1" --> "0..*" Review : escribe
Student "1" --> "0..*" Report : envía
Listing "1" --> "0..*" Report : recibe
Student "1" --> "0..*" SupportTicket : abre

Report -[hidden]down- ChallengePurpose
GuestSupportTicket -[hidden]down- DealStatus
@enduml
