flowchart TB
  subgraph limite["UPC-X · Límite del sistema de software"]
    landing["<small>Contenedor · Sitio estático</small><br/><b>Landing page</b><br/><i>HTML / CSS / JavaScript</i><br/>Presentación y enlaces de acceso.<br/>Sin lógica del marketplace."]
    mobile["<small>Contenedor · Aplicación móvil</small><br/><b>Cliente móvil</b><br/><i>Flutter / Dart</i><br/>Android e iOS.<br/>Mismos casos de uso que la web.<br/>Bearer en almacenamiento seguro."]
    web["<small>Contenedor · SPA</small><br/><b>Cliente web</b><br/><i>Angular / TypeScript</i><br/>Mismos casos de uso que el móvil.<br/>Cookie HttpOnly + Secure.<br/>Diseño responsive."]
    api["<small>Contenedor · API REST</small><br/><b>Backend modular</b><br/><i>Java 21 / Spring Boot / JDBC</i><br/>Identidad y autorización por recurso.<br/>Casos de uso y transacciones ACID.<br/>Contrato OpenAPI; chat por polling.<br/>Monolito modular en un proceso."]
    db["<small>Contenedor · Base de datos</small><br/><b>Datos estructurados</b><br/><i>PostgreSQL 17 / Flyway</i><br/>Cuentas, avisos, chat y acuerdos.<br/>Alojada en Neon con TLS.<br/>No accesible desde los clientes."]
    media["<small>Contenedor · Almacén de archivos</small><br/><b>Fotos y evidencias</b><br/><i>Bucket privado Cloudflare R2</i><br/>Objetos fuera de PostgreSQL.<br/>Acceso mediado por la API.<br/>Evidencias de pago privadas."]
  end
