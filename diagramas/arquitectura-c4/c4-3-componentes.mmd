title: C4 · Nivel 3 · Componentes del backend
---
flowchart TB
  subgraph limite["Backend modular · Java 21 / Spring Boot · Un único contenedor C4"]
    security["<small>Componente</small><br/><b>Entrada y seguridad</b><br/><i>SecurityConfig + controladores REST</i><br/>CORS, límite de acceso, validación DTO.<br/>Sesión actual + permisos por recurso.<br/>La identidad se toma de la sesión."]
    identity["<small>Componente</small><br/><b>Identidad y perfil</b><br/><i>Módulo Identity</i><br/>Registro @upc.edu.pe, OTP y sesión.<br/>BCrypt; reset revoca sesiones.<br/>Perfil del estudiante."]
    market["<small>Componente</small><br/><b>Catálogo y disponibilidad</b><br/><i>Módulo Catalog</i><br/>Publicar, consultar y reservar avisos.<br/>Edición, favoritos y ofertas<br/>continuas."]
    chat["<small>Componente</small><br/><b>Conversaciones y mensajes</b><br/><i>Módulo Communication</i><br/>Un hilo por aviso y comprador.<br/>Solo sus participantes pueden acceder.<br/>Refresco periódico; sin WebSocket."]
    deals["<small>Componente</small><br/><b>Acuerdos y reputación</b><br/><i>Módulo Deals</i><br/>Aceptación ≠ confirmación de entrega.<br/>Bloqueo del aviso; cierre bilateral.<br/>Reseñas, eventos y evidencias."]
    mailAdapter["<small>Componente · Adaptador</small><br/><b>Entrega de correo</b><br/><i>Puerto MailGateway</i><br/>OTP con vencimiento y uso único.<br/>Envío mediante Resend."]
    jdbc["<small>Componente · Adaptador</small><br/><b>Persistencia transaccional</b><br/><i>JdbcClient + @Transactional / Flyway</i><br/>SQL parametrizado, FK, UNIQUE y locks.<br/>Repositorios por módulo.<br/>Migraciones versionadas."]
    mediaAdapter["<small>Componente · Adaptador</small><br/><b>Validación y acceso a medios</b><br/><i>Módulo Media / ObjectStore</i><br/>JPEG/PNG, tamaño, recodificación.<br/>Evidencias privadas en R2.<br/>Acceso autorizado por la API."]
    support["<small>Componente</small><br/><b>Reportes y ayuda</b><br/><i>Módulo Support</i><br/>Recepción de reportes y tickets.<br/>Sin sanción automática.<br/>Autorización propia por recurso."]
  end
  mobile["<small>Contenedor vecino</small><br/><b>Cliente móvil</b><br/><i>Flutter / Dart</i><br/>HTTPS / JSON; bearer; multipart"]
  web["<small>Contenedor vecino</small><br/><b>Cliente web</b><br/><i>Angular / TypeScript</i><br/>HTTPS / JSON; cookie HttpOnly"]
  mail["<small>Sistema externo</small><br/><b>Proveedor de correo</b><br/><i>Resend</i><br/>Entrega al correo del estudiante."]
  db["<small>Contenedor vecino</small><br/><b>PostgreSQL 17</b><br/><i>Datos de UPC-X</i><br/>Único almacén relacional."]
  media["<small>Contenedor vecino</small><br/><b>Almacén de archivos</b><br/><i>Cloudflare R2</i><br/>La API aplica las reglas de acceso."]
